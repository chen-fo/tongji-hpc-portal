# Run backend commands from backend/. Copy this file to .env in the project root.
PORTAL_DATABASE_URL=sqlite:///./data/portal.sqlite3
PORTAL_SSH_MODE=mock
PORTAL_MOCK_ROOT=./data/mock-ssh
PORTAL_MOCK_HOME_BASE=/mock-cluster/home
PORTAL_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local HTTP only. HTTPS deployments MUST set true.
PORTAL_COOKIE_SECURE=false
PORTAL_SESSION_HOURS=12
PORTAL_SSH_ALLOWED_TARGETS=["mock-a:22","mock-b:22","mock-c:22"]
# Optional override; otherwise use SSH config/default verified known_hosts.
# Never disable host key checking or paste private key contents into configuration.
PORTAL_SSH_KNOWN_HOSTS=
PORTAL_SSH_TIMEOUT_SECONDS=10
# JSON list of account aliases for deterministic simulated connection failures.
PORTAL_MOCK_FAIL_ALIASES=[]
# Phase 2: local SSH profiles. Keep empty for Mock. Passwords are NOT supported in this JSON.
# Example for a user-created SSH config alias:
# PORTAL_SSH_PROFILES={"tongji_intel":{"host":"tongji-intel","auth":"auto"}}
# Public Intel endpoint verified against the official handbook (fill YOUR actual username):
# PORTAL_SSH_PROFILES={"tongji_intel":{"host":"logini.tongji.edu.cn","port":10022,"username":"YOUR_HPC_USERNAME","auth":"auto"}}
# In real mode add the resolved HostName:Port to PORTAL_SSH_ALLOWED_TARGETS above.
PORTAL_SSH_PROFILES={}
PORTAL_SSH_CONFIG_FILE=~/.ssh/config
# Optional: profile auth="keychain", keychain_service="Tongji HPC Portal / tongji_intel".
# The Keychain item account must match the resolved HPC username.
# No remote directory writes or real terminal access before explicit test approval:
PORTAL_SSH_WRITE_USERS=[]
PORTAL_TERMINAL_REAL_USERS=[]
PORTAL_TERMINAL_MAX_PER_USER=2
PORTAL_TERMINAL_MAX_PER_ACCOUNT=8
PORTAL_TERMINAL_MAX_TOTAL=32
PORTAL_TERMINAL_IDLE_SECONDS=900
